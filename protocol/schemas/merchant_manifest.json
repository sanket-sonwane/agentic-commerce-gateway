{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "merchant_manifest.json",
  "title": "MerchantManifest",
  "description": "Read-only machine-readable projection of the merchant's public capabilities (GET /.well-known/merchant). Never contains secrets.",
  "type": "object",
  "required": [
    "merchant_id", "name", "protocol", "currency", "supported_categories",
    "capabilities", "endpoints", "payment", "fulfillment", "verification"
  ],
  "properties": {
    "merchant_id": {"type": "string"},
    "name": {"type": "string"},
    "protocol": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "currency": {"const": "INR"},
    "currency_fraction": {"type": "integer"},
    "supported_categories": {"type": "array", "items": {"type": "string"}},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "read": {"type": "boolean"},
          "write": {"type": "boolean"}
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path"],
        "properties": {
          "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "path": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "payment": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {"type": "string"},
        "test_mode": {"type": "boolean"},
        "methods": {"type": "array", "items": {"type": "string"}},
        "driver": {"type": "string"},
        "merchant_initiated": {"type": "boolean"}
      }
    },
    "fulfillment": {
      "type": "object",
      "properties": {
        "methods": {"type": "array", "items": {"type": "string"}},
        "states": {"type": "array", "items": {"type": "string"}},
        "tracking_supported": {"type": "boolean"}
      }
    },
    "verification": {
      "type": "object",
      "required": ["key_id"],
      "properties": {
        "key_id": {"type": "string"},
        "algorithm": {"type": "string"},
        "format": {"type": "string"},
        "public_reference": {"type": "string"}
      }
    }
  }
}
