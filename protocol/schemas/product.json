{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product.json",
  "title": "Product",
  "type": "object",
  "required": ["product_id", "name", "category", "packs"],
  "properties": {
    "product_id": {"type": "string", "pattern": "^prod_"},
    "name": {"type": "string"},
    "category": {"type": "string"},
    "brand": {"type": "string"},
    "description": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack_id", "size", "unit", "price", "currency"],
        "properties": {
          "pack_id": {"type": "string", "pattern": "^pack_"},
          "size": {"type": "number"},
          "unit": {"enum": ["ml", "l", "g", "kg", "pcs"]},
          "price": {"type": "integer", "description": "INR whole rupees"},
          "currency": {"const": "INR"}
        }
      }
    }
  }
}
