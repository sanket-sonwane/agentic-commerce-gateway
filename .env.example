# NVIDIA NIM (OpenAI-compatible) — used by the buyer agent and the merchant agent brain
NIM_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct

# Razorpay TEST mode — REQUIRED. Simulated payments were removed permanently:
# the app refuses to start with any driver other than saved | checkout.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-secret-here
PAYMENT_DRIVER=saved

# Merchant
MERCHANT_DB_PATH=data/merchant.db
ADMIN_TOKEN=admin_demo_token
SHIPPING_FEE=40
FREE_SHIPPING_THRESHOLD=999
RESERVATION_TTL_MINUTES=10

# Merchant Agent runtime (PRD §30 bounded autonomy)
MA_LLM_BRAIN=true
MA_MAX_ITERATIONS=10
MA_MAX_TOOL_CALLS=10

# Buyer service
BUYER_AGENT_ID=buyer_agent_llm_01
DELEGATION_TOKEN=dlg_9f8e7d
MERCHANT_BASE_URL=http://localhost:8000
MAX_AGENT_ITERATIONS=12
MERCHANT_PORT=8000
BUYER_SERVICE_PORT=8001
